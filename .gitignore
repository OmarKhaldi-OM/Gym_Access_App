# Local project reference document
AIDE.md

# Local environment files. Keep safe templates such as .env.example trackable.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Dependencies and generated build/cache output
**/node_modules/
**/.vite/
/frontend/dist/
/backend/target/
**/coverage/
**/.nyc_output/

# Python virtual environments, caches, and bytecode
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
*.tmp
*.temp

# Local databases, exports, and backups (not schema migrations)
*.db
*.sqlite
*.sqlite3
*.dump
*.bak
*.backup
*.sql.gz
*backup*.sql
gymbd_backup.sql

# Private keys and credential containers
*.key
*.pem
*.p12
*.pfx

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini
